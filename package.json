    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "1.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.75.0",
    "react-native": "0.88.0",
